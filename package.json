{
  "name": "@datasolution/vendure-plugin-pricelist",
  "version": "1.0.0",
  "description": "Pricelist plugin for Vendure",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "rimraf lib && tsc -p ./tsconfig.build.json && cp -r src/dashboard lib/src/dashboard",
    "e2e": "mkdir -p e2e/__data__ && cross-env PACKAGE=pricelist vitest --config e2e-common/vitest.config.mts --run"
  },
  "peerDependencies": {
    "@vendure/core": "^3.6.0",
    "@vendure/dashboard": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@gql.tada/cli-utils": "^1.6.5",
    "@swc/core": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vendure-io/docs-generator": "^0.1.0",
    "@vendure/core": "^3.6.2",
    "@vendure/testing": "^3.6.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "fs-extra": "^11.0.0",
    "gql.tada": "^1.8.10",
    "husky": "^9.1.7",
    "lerna": "^9.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^5.0.5",
    "semver": "^7.7.2",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.54.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
